    Serial.print(" IMU ");
    Serial.print(gx, 4); Serial.print(" ");
    Serial.print(gy, 4); Serial.print(" ");
    Serial.print(gz, 4); Serial.print(" ");
    Serial.print(ax, 3); Serial.print(" ");
    Serial.print(ay, 3); Serial.print(" ");
    Serial.println(az, 3);
  }
}

